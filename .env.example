# ===== 应用 =====
APP_NAME=文问
APP_ENV=dev
SECRET_KEY=change-me-in-prod

# ===== 数据库 =====
DATABASE_URL=sqlite:///./wenwen.db

# ===== DeepSeek（LLM 主力）=====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== Qwen（LLM 备选）=====
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# ===== Embedding（本地 sentence-transformers）=====
# MVP 用轻量 bge-small-zh-v1.5 跑通；质量不够换 BAAI/bge-m3（dim 1024）
# 国内下载模型先执行：export HF_ENDPOINT=https://hf-mirror.com
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512

# ===== 支付（沙箱先行）=====
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_KEY=
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=

# ===== 验证码 =====
# true: 验证码接口回显答案（仅自动化测试用，生产必须 false）
CAPTCHA_ECHO=false

# ===== 额度（对应产品设计定价表）=====
FREE_DOC_LIMIT=3
FREE_QUESTION_LIMIT=20
BUYOUT_DOC_LIMIT=100
BUYOUT_QUESTION_LIMIT=200
SUB_MONTHLY_DOC_LIMIT=300
SUB_MONTHLY_QUESTION_LIMIT=1000
